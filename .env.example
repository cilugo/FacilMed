# =====================================================================
# FacilMed — configuração local. Copie para ".env" (o "composer run setup"
# já faz isso) e NÃO suba o .env para o Git.
#
# Os valores abaixo já servem para o XAMPP padrão: MySQL/MariaDB em
# 127.0.0.1, usuário root, sem senha, banco "facilmed" (crie o banco vazio
# no phpMyAdmin antes, com utf8mb4_unicode_ci).
#
# MAIL_MAILER=log: e-mail NÃO sai de verdade; cai em storage/logs/laravel.log.
# =====================================================================

APP_NAME=FacilMed
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Endereço do site. Usado nos links dos e-mails de lembrete (que saem pelo
# agendador, fora de uma visita ao site). XAMPP: http://localhost/FacilMed
# Se usar "composer run dev": http://127.0.0.1:8000
APP_URL=http://localhost/FacilMed

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=facilmed
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@facilmed.test"
MAIL_FROM_NAME="${APP_NAME}"

# 01/10/2026 — e-mail DE VERDADE pelo Brevo (README §2.7). Só com aprovação
# do grupo e só para e-mail de integrante (AGENTS.md §4.1). Para ligar:
#   MAIL_MAILER=brevo
#   BREVO_API_KEY=xkeysib-...          (Brevo → SMTP & API → API keys)
#   MAIL_FROM_ADDRESS=o-email-confirmado-no-brevo@gmail.com
# Sem a chave, o sistema continua no "log" mesmo com MAIL_MAILER=brevo.
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Protótipo antigo em PHP puro (pastas php/ e paginas/). O Laravel ignora
# estas linhas. O protótipo usa um banco SEPARADO: as tabelas dele têm os
# mesmos nomes das do Laravel (medicos, consultas...) e se misturariam.
# ---------------------------------------------------------------------
DB_USER=root
DB_PASS=
DB_NAME=facilmed_prototipo
