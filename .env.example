# Copie este arquivo para ".env" (na raiz do projeto) e preencha com
# as credenciais reais do seu provedor SMTP. NUNCA suba o .env de
# verdade para o Git — só este .env.example, sem segredos.
#
# Se essas variáveis não estiverem preenchidas, o FacilMed cai
# automaticamente em modo de desenvolvimento e mostra o código de
# recuperação de senha direto na tela, sem enviar e-mail de verdade.

# Exemplo com Mailtrap (bom para testar sem mandar e-mail de verdade):
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USER=seu_usuario_mailtrap
# SMTP_PASS=sua_senha_mailtrap

# Exemplo com Gmail (precisa gerar uma "Senha de app" em
# https://myaccount.google.com/apppasswords — a senha normal da
# conta não funciona com SMTP):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=sua_senha_de_app

# Exemplo com SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USER=apikey
# SMTP_PASS=sua_api_key_do_sendgrid

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# E-mail e nome que vão aparecer como remetente
SMTP_FROM_EMAIL=nao-responda@facilmed.com
SMTP_FROM_NAME=FacilMed
